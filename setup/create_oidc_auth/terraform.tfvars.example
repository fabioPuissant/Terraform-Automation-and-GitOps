aws_region      = "us-west-2"
github_repo     = "ned1313/taco-wagon-app"
role_name       = "github-actions-taco-wagon"
iam_policy_arns = [
  # VPC - Create/manage VPC, subnets, route tables, internet gateways
  "arn:aws:iam::aws:policy/AmazonVPCFullAccess",
  # EC2 - Security groups, launch templates, instances
  "arn:aws:iam::aws:policy/AmazonEC2FullAccess",
  # S3 - Terraform state backend storage
  "arn:aws:iam::aws:policy/AmazonS3FullAccess",
  # Auto Scaling - ASG, scaling policies, attachments
  # (Included in EC2FullAccess, but explicit for clarity)
  # CloudWatch - Metric alarms for auto scaling
  "arn:aws:iam::aws:policy/CloudWatchFullAccess",
  # Elastic Load Balancing - NLB, listeners, target groups
  "arn:aws:iam::aws:policy/ElasticLoadBalancingFullAccess",
  # SSM - Read AMI parameter from Parameter Store
  "arn:aws:iam::aws:policy/AmazonSSMReadOnlyAccess"
]
